# Public values only. NEVER put the service_role key in any VITE_ variable:
# everything starting with VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# 1 = use the built-in fake server (no Supabase needed). For UI work and demos only.
VITE_MOCK=0
